# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

# Secret used to sign the session cookie.
# Server only: do NOT add the NEXT_PUBLIC_ prefix to this name.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string
# Public address of the site, used for absolute URLs in metadata, the sitemap and robots.txt.
# Server only. Locally http://localhost:3000; on Vercel set it to the deployed address.
SITE_URL=http://localhost:3000